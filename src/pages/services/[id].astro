---
import { getCollection } from 'astro:content';
import ListingDetail from '@components/ListingDetail.astro';
import Button from '@components/ui/Button.astro';

export async function getStaticPaths() {
  const entries = await getCollection('services');
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry, allEntries: entries },
  }));
}

const { entry, allEntries } = Astro.props;
const { title, description, address, phone, whatsapp } = entry.data;

const canonicalUrl = new URL(`/services/${entry.id}/`, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: title,
  description,
  url: canonicalUrl,
  ...(address ? { address: { '@type': 'PostalAddress', streetAddress: address } } : {}),
  ...(phone ? { telephone: phone } : {}),
};
---

<ListingDetail
  entry={entry}
  allEntries={allEntries}
  categorySlug="services"
  categoryLabel="Services"
  jsonLd={jsonLd}
>
  {whatsapp && (
    <div class="mb-6" slot="header-cta">
      <Button href={`https://wa.me/${whatsapp}`} variant="primary">
        WhatsApp for a quote
      </Button>
    </div>
  )}
</ListingDetail>
