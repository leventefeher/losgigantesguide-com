---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import CategoryIndex from "@components/CategoryIndex.astro";
import categoryImage from "@assets/images/categories/services.jpg";

const entries = await getCollection("services");
const ogImageData = await getImage({ src: categoryImage, width: 1200, height: 630, format: "jpeg" });
---

<BaseLayout
  title="Local Services in Los Gigantes"
  description="Reliable local services in Los Gigantes, Tenerife. Tradespeople, photographers, and other professionals recommended from personal experience."
  ogImage={ogImageData.src}
>
  <CategoryIndex
    heading="Local Services in Los Gigantes"
    intro="Tradespeople and service providers I've used personally or can vouch for. No ads, no commissions."
    categorySlug="services"
    entries={entries}
    emptyMessage="Service recommendations are coming — only people I've actually used get listed. Check back soon."
    noResultsMessage="No services found for this filter."
  />
</BaseLayout>
