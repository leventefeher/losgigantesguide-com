---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import CategoryIndex from "@components/CategoryIndex.astro";
import categoryImage from "@assets/images/categories/restaurants.jpg";

const entries = await getCollection("restaurants");
const ogImageData = await getImage({ src: categoryImage, width: 1200, height: 630, format: "jpeg" });
---

<BaseLayout
  title="Restaurants in Los Gigantes"
  description="Where to eat in Los Gigantes, Tenerife. Fresh fish, local tapas, and honest reviews of the places worth visiting."
  ogImage={ogImageData.src}
>
  <CategoryIndex
    heading="Restaurants in Los Gigantes"
    intro="Where to eat in Los Gigantes — from the marina fish restaurants to the small tapas bars tucked away in the old quarter."
    categorySlug="restaurants"
    entries={entries}
    emptyMessage="Restaurant reviews are on their way — each one gets visited before it's listed. Check back soon."
    noResultsMessage="No restaurants found for this filter."
  />
</BaseLayout>
