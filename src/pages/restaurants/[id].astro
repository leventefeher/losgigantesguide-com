---
import { getCollection } from 'astro:content';
import ListingDetail from '@components/ListingDetail.astro';

export async function getStaticPaths() {
  const entries = await getCollection('restaurants');
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry, allEntries: entries },
  }));
}

const { entry, allEntries } = Astro.props;
const { title, description, address, phone, priceRange, cuisine, openingHours } = entry.data;

const canonicalUrl = new URL(`/restaurants/${entry.id}/`, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: title,
  description,
  url: canonicalUrl,
  ...(cuisine?.length ? { servesCuisine: cuisine } : {}),
  ...(priceRange ? { priceRange } : {}),
  ...(address ? { address: { '@type': 'PostalAddress', streetAddress: address } } : {}),
  ...(phone ? { telephone: phone } : {}),
  ...(openingHours ? { openingHours } : {}),
};
---

<ListingDetail
  entry={entry}
  allEntries={allEntries}
  categorySlug="restaurants"
  categoryLabel="Restaurants"
  jsonLd={jsonLd}
/>
