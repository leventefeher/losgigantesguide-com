---
import { getCollection } from 'astro:content';
import ListingDetail from '@components/ListingDetail.astro';

export async function getStaticPaths() {
  const entries = await getCollection('accommodation');
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry, allEntries: entries },
  }));
}

const { entry, allEntries } = Astro.props;
const { title, description, address, phone, roomTypes, sleeps } = entry.data;

const canonicalUrl = new URL(`/accommodation/${entry.id}/`, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: title,
  description,
  url: canonicalUrl,
  ...(address ? { address: { '@type': 'PostalAddress', streetAddress: address } } : {}),
  ...(phone ? { telephone: phone } : {}),
  ...(sleeps ? { numberOfRooms: sleeps } : {}),
};
---

<ListingDetail
  entry={entry}
  allEntries={allEntries}
  categorySlug="accommodation"
  categoryLabel="Stay"
  jsonLd={jsonLd}
>
  {(roomTypes.length > 0 || sleeps) && (
    <div class="flex flex-wrap gap-3 mb-6" slot="body-top">
      {roomTypes.map((type) => (
        <span class="text-sm bg-sea-salt-dark text-volcanic border border-border px-3 py-1 rounded-full">
          {type}
        </span>
      ))}
      {sleeps && (
        <span class="text-sm bg-sea-salt-dark text-volcanic border border-border px-3 py-1 rounded-full">
          Sleeps {sleeps}
        </span>
      )}
    </div>
  )}
</ListingDetail>
