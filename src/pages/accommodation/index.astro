---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import CategoryIndex from "@components/CategoryIndex.astro";
import categoryImage from "@assets/images/categories/stay.jpg";

const entries = await getCollection("accommodation");
const ogImageData = await getImage({ src: categoryImage, width: 1200, height: 630, format: "jpeg" });
---

<BaseLayout
  title="Where to Stay in Los Gigantes, Tenerife"
  description="Accommodation in Los Gigantes, Tenerife. Self-catering apartments and places worth staying for a holiday or longer."
  ogImage={ogImageData.src}
>
  <CategoryIndex
    heading="Where to Stay in Los Gigantes"
    intro="Accommodation options in Los Gigantes that are worth recommending — with honest notes on what works for short visits versus longer stays."
    categorySlug="accommodation"
    entries={entries}
    emptyMessage="Accommodation picks are on their way — places get stayed in or inspected before they're listed. Check back soon."
    noResultsMessage="No places found for this filter."
  />
</BaseLayout>
