---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import CategoryIndex from "@components/CategoryIndex.astro";
import categoryImage from "@assets/images/categories/things-to-do.jpg";

const entries = await getCollection("activities");
const ogImageData = await getImage({ src: categoryImage, width: 1200, height: 630, format: "jpeg" });
---

<BaseLayout
  title="Things to Do in Los Gigantes"
  description="The best activities in Los Gigantes, Tenerife — whale watching, sea kayaking, coastal walks and more. Honest local recommendations."
  ogImage={ogImageData.src}
>
  <CategoryIndex
    heading="Things to Do in Los Gigantes"
    intro="Activities worth doing in and around Los Gigantes, Tenerife — from the iconic cliffs to quiet walks with no one else around."
    categorySlug="activities"
    entries={entries}
    emptyMessage="No activities listed yet — check back soon."
    noResultsMessage="No activities found for this filter."
  />
</BaseLayout>
