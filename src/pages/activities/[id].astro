---
import { getCollection } from 'astro:content';
import ListingDetail from '@components/ListingDetail.astro';

export async function getStaticPaths() {
  const entries = await getCollection('activities');
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry, allEntries: entries },
  }));
}

const { entry, allEntries } = Astro.props;
const { title, description, address, phone, lat, lng } = entry.data;

const canonicalUrl = new URL(`/activities/${entry.id}/`, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: title,
  description,
  url: canonicalUrl,
  ...(address ? { address: { '@type': 'PostalAddress', streetAddress: address } } : {}),
  ...(phone ? { telephone: phone } : {}),
  ...(lat && lng ? { geo: { '@type': 'GeoCoordinates', latitude: lat, longitude: lng } } : {}),
};
---

<ListingDetail
  entry={entry}
  allEntries={allEntries}
  categorySlug="activities"
  categoryLabel="Things to do"
  jsonLd={jsonLd}
/>
