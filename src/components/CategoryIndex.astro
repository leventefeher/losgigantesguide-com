---
import type { CollectionEntry } from "astro:content";
import PlaceCard from "@components/PlaceCard.astro";

type Entry =
  | CollectionEntry<"activities">
  | CollectionEntry<"restaurants">
  | CollectionEntry<"services">
  | CollectionEntry<"accommodation">;

interface Props {
  heading: string;
  intro: string;
  categorySlug: string;
  entries: Entry[];
  emptyMessage: string;
  noResultsMessage: string;
}

const { heading, intro, categorySlug, entries, emptyMessage, noResultsMessage } =
  Astro.props;

// Partition: open/seasonal first, closed last
const active = entries.filter((e) => e.data.status !== "closed");
const closed = entries.filter((e) => e.data.status === "closed");
const sorted = [...active, ...closed];

// Unique tags across all entries
const allTags = [...new Set(sorted.flatMap((e) => e.data.tags))].sort();
---

<div class="max-w-6xl mx-auto px-4 py-12">
  <h1
    class="font-serif font-bold text-cliff-deep mb-3"
    style="font-size: clamp(1.8rem, 4vw, 2.5rem);"
  >
    {heading}
  </h1>
  <p class="text-cliff-deep text-lg mb-6 max-w-2xl">
    {intro}
  </p>

  {
    allTags.length > 0 && (
      <nav aria-label="Filter by tag" class="mb-8">
        <ul
          class="flex flex-wrap gap-2 list-none p-0 m-0"
          role="list"
          data-tag-filters
        >
          <li>
            <button
              data-tag="all"
              class="tag-btn text-sm no-underline bg-cliff-deep text-sea-salt border border-cliff-deep px-3 py-1 rounded-full transition-colors cursor-pointer"
              aria-pressed="true"
            >
              All
            </button>
          </li>
          {allTags.map((tag) => (
            <li>
              <button
                data-tag={tag}
                class="tag-btn text-sm text-cliff-deep bg-sea-salt border border-border px-3 py-1 rounded-full hover:bg-sea-salt-dark transition-colors cursor-pointer"
                aria-pressed="false"
              >
                {tag}
              </button>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  {
    sorted.length > 0 ? (
      <ul
        class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 list-none p-0 m-0"
        role="list"
        data-listing-grid
      >
        {sorted.map((entry) => (
          <li data-tags={entry.data.tags.join(",")}>
            <PlaceCard entry={entry} categorySlug={categorySlug} headingLevel={2} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-cliff-deep bg-white border border-border rounded-xl px-5 py-6">
        {emptyMessage}
      </p>
    )
  }

  <p data-no-results class="hidden text-cliff-deep mt-8">
    {noResultsMessage}
  </p>
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".tag-btn");
  const cards = document.querySelectorAll<HTMLLIElement>("[data-listing-grid] > li");
  const noResults = document.querySelector<HTMLParagraphElement>("[data-no-results]");

  function applyFilter(selected: string) {
    // Update button states
    buttons.forEach((btn) => {
      const isActive = btn.dataset.tag === selected;
      btn.setAttribute("aria-pressed", String(isActive));
      if (isActive) {
        btn.classList.add("bg-cliff-deep", "text-sea-salt", "border-cliff-deep");
        btn.classList.remove("bg-sea-salt", "text-cliff-deep", "border-border");
      } else {
        btn.classList.remove("bg-cliff-deep", "text-sea-salt", "border-cliff-deep");
        btn.classList.add("bg-sea-salt", "text-cliff-deep", "border-border");
      }
    });

    // Show/hide cards
    let visible = 0;
    cards.forEach((card) => {
      const tags = card.dataset.tags?.split(",") ?? [];
      const show = selected === "all" || tags.includes(selected);
      card.hidden = !show;
      if (show) visible++;
    });

    noResults?.classList.toggle("hidden", visible > 0);
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => applyFilter(btn.dataset.tag ?? "all"));
  });
</script>
