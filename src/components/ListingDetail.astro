---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import QuickInfo from '@components/QuickInfo.astro';
import RelatedListings from '@components/RelatedListings.astro';

type Entry =
  | CollectionEntry<'activities'>
  | CollectionEntry<'restaurants'>
  | CollectionEntry<'services'>
  | CollectionEntry<'accommodation'>;

interface Props {
  entry: Entry;
  allEntries: Entry[];
  categorySlug: string;
  categoryLabel: string;
  jsonLd: object;
}

const { entry, allEntries, categorySlug, categoryLabel, jsonLd } = Astro.props;
const { title, description, coverImage, coverImageAlt, address, phone, website, status, seasonNote, priceRange, tags } =
  entry.data;

// Collection-specific extras QuickInfo knows how to render
const openingHours = 'openingHours' in entry.data ? entry.data.openingHours : undefined;
const whatsapp = 'whatsapp' in entry.data ? entry.data.whatsapp : undefined;

const { Content } = await render(entry);

const canonicalUrl = new URL(`/${categorySlug}/${entry.id}/`, Astro.site).href;
const ogImageData = coverImage
  ? await getImage({ src: coverImage, width: 1200, height: 630, format: 'jpeg' })
  : null;
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={ogImageData?.src}
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="max-w-4xl mx-auto px-4 py-10">
    <Breadcrumb
      items={[
        { label: 'Home', href: '/' },
        { label: categoryLabel, href: `/${categorySlug}/` },
        { label: title },
      ]}
    />

    <h1 class="font-serif font-bold text-cliff-deep mb-6" style="font-size: clamp(1.8rem, 4vw, 2.5rem);">
      {title}
    </h1>

    {coverImage && (
      <Image
        src={coverImage}
        alt={coverImageAlt ?? ''}
        width={900}
        height={500}
        loading="eager"
        decoding="sync"
        formats={['avif', 'webp']}
        class="w-full rounded-xl mb-8 object-cover"
        style="max-height: 500px;"
      />
    )}

    <slot name="header-cta" />

    <div class="grid md:grid-cols-[1fr_280px] gap-8 items-start">
      <!-- Main content -->
      <div>
        <slot name="body-top" />
        <div class="prose max-w-none text-cliff-deep">
          <Content />
        </div>
      </div>

      <!-- Sidebar -->
      <div class="flex flex-col gap-4">
        <QuickInfo
          status={status}
          seasonNote={seasonNote}
          address={address}
          phone={phone}
          whatsapp={whatsapp}
          website={website}
          openingHours={openingHours}
          priceRange={priceRange}
        />
      </div>
    </div>

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="mt-8 pt-6 border-t border-border">
        <p class="text-xs font-semibold uppercase tracking-wider text-cliff-deep mb-3">Tagged:</p>
        <ul class="flex flex-wrap gap-2 list-none p-0 m-0" role="list">
          {tags.map((tag) => (
            <li>
              <a
                href={`/tags/${tag}/`}
                class="text-sm text-cliff-deep no-underline bg-sea-salt border border-border px-3 py-1 rounded-full hover:bg-sea-salt-dark"
              >
                {tag}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <RelatedListings
      currentId={entry.id}
      currentTags={tags}
      entries={allEntries}
      categorySlug={categorySlug}
    />
  </div>
</BaseLayout>
